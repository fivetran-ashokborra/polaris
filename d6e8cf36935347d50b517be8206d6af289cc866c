            "content": "/*\n * Licensed to the Apache Software Foundation (ASF) under one\n * or more contributor license agreements.  See the NOTICE file\n * distributed with this work for additional information\n * regarding copyright ownership.  The ASF licenses this file\n * to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance\n * with the License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing,\n * software distributed under the License is distributed on an\n * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\n * KIND, either express or implied.  See the License for the\n * specific language governing permissions and limitations\n * under the License.\n */\n\npackage org.apache.polaris.core.storage.azure;\n\nimport com.fivetran.polaris.shaded.com.fivetran.core.interfaces.setup.UnifiedDataLakeCredentials;\nimport java.util.List;\nimport java.util.Optional;\nimport java.util.concurrent.CountDownLatch;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport java.util.function.Function;\nimport org.assertj.core.api.Assertions;\nimport org.junit.jupiter.api.Test;\n\n/** Unit tests for {@link AzureSecredCredentialCache}. */\npublic class AzureSecredCredentialCacheSpec {\n\n  private static final String CATALOG_A = \"catalog-a\";\n  private static final String CATALOG_B = \"catalog-b\";\n\n  private static UnifiedDataLakeCredentials creds(String secret) {\n    return new UnifiedDataLakeCredentials(\n        \"tenant-id\", \"client-id\", Optional.empty(), \"\", secret);\n  }\n\n  /** Minimal stub loader that records how many times it was invoked per key. */\n  private static final class CountingLoader\n      implements Function<String, UnifiedDataLakeCredentials> {\n    final AtomicInteger calls = new AtomicInteger();\n    private final Function<String, UnifiedDataLakeCredentials> delegate;\n\n    CountingLoader(Function<String, UnifiedDataLakeCredentials> delegate) {\n      this.delegate = delegate;\n    }\n\n    @Override\n    public UnifiedDataLakeCredentials apply(String key) {\n      calls.incrementAndGet();\n      return delegate.apply(key);\n    }\n  }\n\n  @Test\n  void getOrFetch_invokesLoader_onCacheMiss() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials expected = creds(\"secret-A\");\n    CountingLoader loader = new CountingLoader(k -> expected);\n\n    UnifiedDataLakeCredentials actual = cache.getOrFetch(CATALOG_A, loader);\n\n    Assertions.assertThat(actual).isSameAs(expected);\n    Assertions.assertThat(loader.calls.get()).isEqualTo(1);\n    Assertions.assertThat(cache.getEstimatedSize()).isEqualTo(1);\n  }\n\n  @Test\n  void getOrFetch_doesNotInvokeLoader_onCacheHit() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials expected = creds(\"secret-A\");\n    CountingLoader loader = new CountingLoader(k -> expected);\n\n    UnifiedDataLakeCredentials first = cache.getOrFetch(CATALOG_A, loader);\n    UnifiedDataLakeCredentials second = cache.getOrFetch(CATALOG_A, loader);\n    UnifiedDataLakeCredentials third = cache.getOrFetch(CATALOG_A, loader);\n\n    Assertions.assertThat(loader.calls.get()).isEqualTo(1);\n    Assertions.assertThat(first).isSameAs(expected);\n    Assertions.assertThat(second).isSameAs(expected);\n    Assertions.assertThat(third).isSameAs(expected);\n  }\n\n  @Test\n  void getOrFetch_differentKeys_invokesLoaderOncePerKey() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials credsA = creds(\"secret-A\");\n    UnifiedDataLakeCredentials credsB = creds(\"secret-B\");\n    CountingLoader loader =\n        new CountingLoader(k -> k.equals(CATALOG_A) ? credsA : credsB);\n\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, loader)).isSameAs(credsA);\n    Assertions.assertThat(cache.getOrFetch(CATALOG_B, loader)).isSameAs(credsB);\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, loader)).isSameAs(credsA);\n    Assertions.assertThat(cache.getOrFetch(CATALOG_B, loader)).isSameAs(credsB);\n\n    Assertions.assertThat(loader.calls.get()).isEqualTo(2);\n    Assertions.assertThat(cache.getEstimatedSize()).isEqualTo(2);\n  }\n\n  @Test\n  void invalidate_forcesReload_onNextFetch() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials v1 = creds(\"secret-v1\");\n    UnifiedDataLakeCredentials v2 = creds(\"secret-v2\");\n\n    AtomicInteger call = new AtomicInteger();\n    Function<String, UnifiedDataLakeCredentials> loader =\n        k -> (call.incrementAndGet() == 1 ? v1 : v2);\n\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, loader)).isSameAs(v1);\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, loader)).isSameAs(v1); // cached\n\n    cache.invalidate(CATALOG_A);\n\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, loader)).isSameAs(v2); // reloaded\n    Assertions.assertThat(call.get()).isEqualTo(2);\n  }\n\n  @Test\n  void invalidate_nonExistentKey_isNoOp() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n\n    // Must not throw.\n    cache.invalidate(\"never-cached\");\n\n    Assertions.assertThat(cache.getEstimatedSize()).isZero();\n  }\n\n  @Test\n  void getOrFetch_loaderThrows_propagatesAndDoesNotCache() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    RuntimeException boom = new RuntimeException(\"SECRED down\");\n\n    AtomicInteger call = new AtomicInteger();\n    Function<String, UnifiedDataLakeCredentials> loader =\n        k -> {\n          call.incrementAndGet();\n          throw boom;\n        };\n\n    Assertions.assertThatThrownBy(() -> cache.getOrFetch(CATALOG_A, loader))\n        .isInstanceOf(RuntimeException.class)\n        .hasMessageContaining(\"SECRED down\");\n\n    // Entry must NOT be cached; next call should invoke loader again.\n    UnifiedDataLakeCredentials recovery = creds(\"recovered\");\n    Function<String, UnifiedDataLakeCredentials> recoveringLoader =\n        k -> {\n          call.incrementAndGet();\n          return recovery;\n        };\n    Assertions.assertThat(cache.getOrFetch(CATALOG_A, recoveringLoader)).isSameAs(recovery);\n    Assertions.assertThat(call.get()).isEqualTo(2);\n  }\n\n  @Test\n  void getIfPresent_reflectsCacheState() {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials expected = creds(\"secret-A\");\n\n    Assertions.assertThat(cache.getIfPresent(CATALOG_A)).isNull();\n\n    cache.getOrFetch(CATALOG_A, k -> expected);\n    Assertions.assertThat(cache.getIfPresent(CATALOG_A)).isSameAs(expected);\n\n    cache.invalidate(CATALOG_A);\n    Assertions.assertThat(cache.getIfPresent(CATALOG_A)).isNull();\n  }\n\n  /**\n   * Concurrent callers for the same key must only cause the loader to be invoked once.\n   * This exercises Caffeine's single-flight guarantee on {@code cache.get(key, mappingFunction)}.\n   */\n  @Test\n  void getOrFetch_concurrentSameKey_loaderCalledOnce() throws Exception {\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    UnifiedDataLakeCredentials expected = creds(\"secret-A\");\n\n    int threads = 16;\n    CountDownLatch startLatch = new CountDownLatch(1);\n    CountDownLatch loaderEntered = new CountDownLatch(1);\n    CountDownLatch loaderRelease = new CountDownLatch(1);\n    AtomicInteger loaderCalls = new AtomicInteger();\n\n    Function<String, UnifiedDataLakeCredentials> slowLoader =\n        k -> {\n          loaderCalls.incrementAndGet();\n          loaderEntered.countDown();\n          try {\n            // Hold the loader long enough that other threads pile up behind it.\n            loaderRelease.await(5, TimeUnit.SECONDS);\n          } catch (InterruptedException e) {\n            Thread.currentThread().interrupt();\n          }\n          return expected;\n        };\n\n    ExecutorService pool = Executors.newFixedThreadPool(threads);\n    try {\n      List<Future<UnifiedDataLakeCredentials>> futures = new java.util.ArrayList<>(threads);\n      for (int i = 0; i < threads; i++) {\n        futures.add(\n            pool.submit(\n                () -> {\n                  startLatch.await();\n                  return cache.getOrFetch(CATALOG_A, slowLoader);\n                }));\n      }\n      startLatch.countDown();\n\n      // Make sure the first thread is inside the loader before releasing.\n      Assertions.assertThat(loaderEntered.await(5, TimeUnit.SECONDS)).isTrue();\n      loaderRelease.countDown();\n\n      for (Future<UnifiedDataLakeCredentials> f : futures) {\n        Assertions.assertThat(f.get(5, TimeUnit.SECONDS)).isSameAs(expected);\n      }\n    } finally {\n      pool.shutdownNow();\n    }\n\n    Assertions.assertThat(loaderCalls.get()).isEqualTo(1);\n    Assertions.assertThat(cache.getEstimatedSize()).isEqualTo(1);\n  }\n}\n",
