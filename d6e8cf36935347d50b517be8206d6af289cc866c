            "content": "/*\n * Licensed to the Apache Software Foundation (ASF) under one\n * or more contributor license agreements.  See the NOTICE file\n * distributed with this work for additional information\n * regarding copyright ownership.  The ASF licenses this file\n * to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance\n * with the License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing,\n * software distributed under the License is distributed on an\n * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\n * KIND, either express or implied.  See the License for the\n * specific language governing permissions and limitations\n * under the License.\n */\n\npackage org.apache.polaris.core.storage.azure;\n\nimport static org.apache.polaris.core.storage.azure.AzureCredentialsStorageIntegration.toAccessConfig;\nimport static org.mockito.ArgumentMatchers.any;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.Mockito.doAnswer;\nimport static org.mockito.Mockito.mock;\nimport static org.mockito.Mockito.spy;\nimport static org.mockito.Mockito.times;\nimport static org.mockito.Mockito.verify;\nimport static org.mockito.Mockito.when;\n\nimport com.azure.core.credential.AccessToken;\nimport com.azure.core.credential.TokenCredential;\nimport com.azure.core.credential.TokenRequestContext;\nimport com.azure.core.exception.ClientAuthenticationException;\nimport com.azure.core.http.HttpResponse;\nimport com.fivetran.polaris.shaded.com.fivetran.core.interfaces.setup.UnifiedDataLakeCredentials;\nimport com.fivetran.polaris.shaded.com.fivetran.secrets.common.CredentialServiceV2;\nimport com.fivetran.polaris.shaded.com.fivetran.secrets.common.GroupCredentialType;\nimport java.time.Instant;\nimport java.util.Optional;\nimport java.util.Set;\nimport org.apache.polaris.core.config.PolarisConfigurationStore;\nimport org.apache.polaris.core.config.RealmConfig;\nimport org.apache.polaris.core.config.RealmConfigImpl;\nimport org.apache.polaris.core.storage.AccessConfig;\nimport org.apache.polaris.core.storage.StorageAccessProperty;\nimport org.assertj.core.api.Assertions;\nimport org.junit.jupiter.api.Test;\nimport reactor.core.publisher.Mono;\n\npublic class AzureCredentialsStorageIntegrationTest {\n\n  private static final String TEST_CATALOG = \"test-catalog\";\n  private static final String TEST_TENANT_ID = \"test-tenant-id\";\n  private static final String TEST_CLIENT_ID = \"test-client-id\";\n  private static final String TEST_SECRET = \"test-secret\";\n  private static final String TEST_LOCATION =\n      \"abfss://container@account.dfs.core.windows.net/path\";\n\n  private static final RealmConfig EMPTY_REALM_CONFIG =\n      new RealmConfigImpl(new PolarisConfigurationStore() {}, () -> \"realm\");\n\n  @Test\n  public void testAzureCredentialFormatting() {\n    Instant expiresAt = Instant.ofEpochMilli(Long.MAX_VALUE);\n\n    AccessConfig noSuffixResult =\n        toAccessConfig(\"sasToken\", \"some_account\", expiresAt, Optional.empty());\n    Assertions.assertThat(noSuffixResult.credentials()).hasSize(2);\n    Assertions.assertThat(noSuffixResult.credentials()).containsKey(\"adls.sas-token.some_account\");\n    Assertions.assertThat(noSuffixResult.credentials())\n        .doesNotContainKey(\n            StorageAccessProperty.AZURE_REFRESH_CREDENTIALS_ENDPOINT.getPropertyName());\n\n    AccessConfig adlsSuffixResult =\n        toAccessConfig(\n            \"sasToken\",\n            \"some_account.\" + AzureLocation.ADLS_ENDPOINT,\n            expiresAt,\n            Optional.of(\"endpoint/credentials\"));\n    Assertions.assertThat(adlsSuffixResult.credentials()).hasSize(3);\n    Assertions.assertThat(adlsSuffixResult.credentials())\n        .containsKey(\"adls.sas-token.some_account\");\n    Assertions.assertThat(adlsSuffixResult.credentials())\n        .containsKey(\"adls.sas-token.some_account.\" + AzureLocation.ADLS_ENDPOINT);\n\n    Assertions.assertThat(adlsSuffixResult.extraProperties())\n        .containsEntry(\n            StorageAccessProperty.AZURE_REFRESH_CREDENTIALS_ENDPOINT.getPropertyName(),\n            \"endpoint/credentials\");\n\n    AccessConfig blobSuffixResult =\n        toAccessConfig(\n            \"sasToken\", \"some_account.\" + AzureLocation.BLOB_ENDPOINT, expiresAt, Optional.empty());\n    Assertions.assertThat(blobSuffixResult.credentials()).hasSize(3);\n    Assertions.assertThat(blobSuffixResult.credentials())\n        .containsKey(\"adls.sas-token.some_account\");\n    Assertions.assertThat(blobSuffixResult.credentials())\n        .containsKey(\"adls.sas-token.some_account.\" + AzureLocation.BLOB_ENDPOINT);\n  }\n\n  // ===========================================================================================\n  // Reactive cache-invalidation tests — exercise the state machine in getSubscopedCreds.\n  //\n  // Flow under test (inside the for-loop in getSubscopedCreds):\n  //   attempt 1: getAccessToken throws ClientAuthenticationException\n  //     - if it matches the AADSTS-credential-invalid list AND we have not already refreshed,\n  //       invalidate the cache, call getOrFetchSecret() to refetch SECRED, set\n  //       secredRefreshAttempted=true, and continue to the next iteration.\n  //     - otherwise, propagate the exception.\n  //   attempt 2+: runs with the refreshed azureCredential.\n  //\n  // Test boundary: these tests verify that cache invalidation and SECRED refetching happen as\n  // expected at the getAccessToken level. They do NOT drive the subsequent SAS generation to\n  // success — that would require a live Azure Storage endpoint. Each test uses Mockito.spy on\n  // AzureCredentialsStorageIntegration to intercept the real getOrFetchSecret() call and swap\n  // azureCredential with a controlled mock so no attempt reaches real Azure AD.\n  // ===========================================================================================\n\n  private UnifiedDataLakeCredentials createTestCredentials() {\n    return new UnifiedDataLakeCredentials(\n        TEST_TENANT_ID, TEST_CLIENT_ID, Optional.empty(), \"\", TEST_SECRET);\n  }\n\n  private AzureStorageConfigurationInfo testConfig() {\n    return AzureStorageConfigurationInfo.builder()\n        .addAllowedLocations(TEST_LOCATION)\n        .tenantId(TEST_TENANT_ID)\n        .build();\n  }\n\n  /** A Mono that fails synchronously with a ClientAuthenticationException carrying {@code message}. */\n  private Mono<AccessToken> failingTokenMono(String message) {\n    return Mono.error(new ClientAuthenticationException(message, (HttpResponse) null));\n  }\n\n  /**\n   * Wraps the integration in a spy that intercepts {@code getOrFetchSecret()}: the real method\n   * runs (invalidating the cache and re-fetching from SECRED, rebuilding a real\n   * ClientSecretCredential), and then we overwrite {@code azureCredential} with the supplied mock\n   * so attempt 2 does not reach real Azure AD.\n   */\n  private AzureCredentialsStorageIntegration spyWithControlledRefresh(\n      AzureCredentialsStorageIntegration real, TokenCredential postRefreshCredential) {\n    AzureCredentialsStorageIntegration spy = spy(real);\n    doAnswer(\n            inv -> {\n              inv.callRealMethod();\n              spy.azureCredential = postRefreshCredential;\n              return null;\n            })\n        .when(spy)\n        .getOrFetchSecret();\n    return spy;\n  }\n\n  @Test\n  void getSubscopedCreds_invalidatesCacheAndRefetchesSecred_onAADSTSError() {\n    // Arrange — SECRED returns valid creds on every call.\n    CredentialServiceV2 mockService = mock(CredentialServiceV2.class);\n    when(mockService.getGroupSecret(\n            eq(TEST_CATALOG),\n            eq(GroupCredentialType.WAREHOUSE),\n            eq(UnifiedDataLakeCredentials.class)))\n        .thenReturn(createTestCredentials());\n\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    AzureCredentialsStorageIntegration integration =\n        new AzureCredentialsStorageIntegration(testConfig(), TEST_CATALOG, mockService, cache);\n\n    // Precondition — constructor populated the cache via one SECRED call.\n    verify(mockService, times(1)).getGroupSecret(any(), any(), any());\n    Assertions.assertThat(cache.getIfPresent(TEST_CATALOG)).isNotNull();\n\n    // Stage attempt 1: azureCredential throws AADSTS7000215 from getAccessToken.\n    TokenCredential failingCred = mock(TokenCredential.class);\n    when(failingCred.getToken(any(TokenRequestContext.class)))\n        .thenReturn(failingTokenMono(\"AADSTS7000215: Invalid client secret\"));\n    integration.azureCredential = failingCred;\n\n    // Stage attempt 2: throws a DIFFERENT, non-AADSTS ClientAuthenticationException so the loop\n    // exits at attempt 2 without reaching SAS generation (which would make a real network call).\n    TokenCredential refreshedCred = mock(TokenCredential.class);\n    when(refreshedCred.getToken(any(TokenRequestContext.class)))\n        .thenReturn(failingTokenMono(\"post-refresh failure — different, not AADSTS\"));\n\n    AzureCredentialsStorageIntegration spy = spyWithControlledRefresh(integration, refreshedCred);\n\n    // Act — attempt 2 propagates its non-AADSTS exception.\n    Assertions.assertThatThrownBy(\n            () ->\n                spy.getSubscopedCreds(\n                    EMPTY_REALM_CONFIG, false, Set.of(TEST_LOCATION), Set.of(), Optional.empty()))\n        .isInstanceOf(ClientAuthenticationException.class);\n\n    // Assert — refresh triggered: SECRED called twice, getOrFetchSecret invoked once via the\n    // reactive-refresh path (constructor call does not route through the spy).\n    verify(mockService, times(2)).getGroupSecret(any(), any(), any());\n    verify(spy, times(1)).getOrFetchSecret();\n  }\n\n  @Test\n  void getSubscopedCreds_doesNotRefreshCache_onNonAADSTSClientAuthError() {\n    // Arrange — SECRED returns valid creds; constructor populates the cache normally.\n    CredentialServiceV2 mockService = mock(CredentialServiceV2.class);\n    when(mockService.getGroupSecret(any(), any(), any())).thenReturn(createTestCredentials());\n\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    AzureCredentialsStorageIntegration integration =\n        new AzureCredentialsStorageIntegration(testConfig(), TEST_CATALOG, mockService, cache);\n\n    // A ClientAuthenticationException without any AADSTS code — represents a transient AAD\n    // failure that must NOT be treated as a credential-invalid signal.\n    TokenCredential failingCred = mock(TokenCredential.class);\n    when(failingCred.getToken(any(TokenRequestContext.class)))\n        .thenReturn(failingTokenMono(\"Temporary AAD throttling — please retry\"));\n    integration.azureCredential = failingCred;\n\n    // Act — exception must propagate untouched (no invalidation, no refresh).\n    Assertions.assertThatThrownBy(\n            () ->\n                integration.getSubscopedCreds(\n                    EMPTY_REALM_CONFIG, false, Set.of(TEST_LOCATION), Set.of(), Optional.empty()))\n        .isInstanceOf(ClientAuthenticationException.class);\n\n    // Assert — SECRED called only once (constructor). Cache entry still present.\n    verify(mockService, times(1)).getGroupSecret(any(), any(), any());\n    Assertions.assertThat(cache.getIfPresent(TEST_CATALOG)).isNotNull();\n  }\n\n  @Test\n  void getSubscopedCreds_doesNotRefreshTwice_whenSecondAttemptAlsoThrowsAADSTS() {\n    // Loop-guard scenario: once secredRefreshAttempted=true, a second AADSTS on attempt 2 must\n    // NOT trigger another cache invalidation or a third SECRED call. Models a customer that\n    // rotated their Azure AD secret but has not yet updated Fivetran's SECRED entry.\n    CredentialServiceV2 mockService = mock(CredentialServiceV2.class);\n    when(mockService.getGroupSecret(any(), any(), any())).thenReturn(createTestCredentials());\n\n    AzureSecredCredentialCache cache = new AzureSecredCredentialCache();\n    AzureCredentialsStorageIntegration integration =\n        new AzureCredentialsStorageIntegration(testConfig(), TEST_CATALOG, mockService, cache);\n\n    // Attempt 1: AADSTS.\n    TokenCredential failingCred = mock(TokenCredential.class);\n    when(failingCred.getToken(any(TokenRequestContext.class)))\n        .thenReturn(failingTokenMono(\"AADSTS7000215: Invalid client secret\"));\n    integration.azureCredential = failingCred;\n\n    // Attempt 2 after refresh: also AADSTS (refetched value is still bad).\n    TokenCredential stillFailingCred = mock(TokenCredential.class);\n    when(stillFailingCred.getToken(any(TokenRequestContext.class)))\n        .thenReturn(failingTokenMono(\"AADSTS7000215: Invalid client secret\"));\n\n    AzureCredentialsStorageIntegration spy =\n        spyWithControlledRefresh(integration, stillFailingCred);\n\n    // Act — second AADSTS must propagate instead of triggering another refresh.\n    Assertions.assertThatThrownBy(\n            () ->\n                spy.getSubscopedCreds(\n                    EMPTY_REALM_CONFIG, false, Set.of(TEST_LOCATION), Set.of(), Optional.empty()))\n        .isInstanceOf(ClientAuthenticationException.class);\n\n    // Assert — SECRED called exactly twice (constructor + single refresh), not three times.\n    verify(mockService, times(2)).getGroupSecret(any(), any(), any());\n    verify(spy, times(1)).getOrFetchSecret();\n  }\n}\n",
